# Every text file is stored and checked out with LF, whatever the
# workstation's core.autocrlf says (containers and PHP expect LF).
* text=auto eol=lf

*.png    binary
*.jpg    binary
*.jpeg   binary
*.webp   binary
*.avif   binary
*.gif    binary
*.ico    binary
*.pdf    binary
*.woff   binary
*.woff2  binary
*.ttf    binary
*.zip    binary
*.gz     binary
