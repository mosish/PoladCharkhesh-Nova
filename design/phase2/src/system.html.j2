<!doctype html>
<html lang="en" dir="ltr" class="no-js">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<title>Nova Design System</title>
<meta name="robots" content="noindex">
<style>
@font-face{font-family:"Vazirmatn";src:url(assets/fonts/vazirmatn-Regular-fa.woff2) format("woff2");font-weight:400;font-display:swap}
@font-face{font-family:"Vazirmatn";src:url(assets/fonts/vazirmatn-Bold-fa.woff2) format("woff2");font-weight:700;font-display:swap}
@font-face{font-family:"JetBrains Mono";src:url(assets/fonts/jbmono-400.woff2) format("woff2");font-weight:400;font-display:swap}
@font-face{font-family:"JetBrains Mono";src:url(assets/fonts/jbmono-600.woff2) format("woff2");font-weight:600;font-display:swap}
</style>
<link rel="stylesheet" href="assets/nova.css">
<style>
.ds { display: grid; grid-template-columns: 220px minmax(0, 1fr); gap: 48px; align-items: start; padding-block: 32px 96px; }
.ds-nav { position: sticky; top: calc(var(--bar-h) + 16px); display: grid; gap: 2px; font-size: .875rem; }
.ds-nav a { color: var(--ink-2); text-decoration: none; padding: 4px 0; border-inline-start: 2px solid transparent; padding-inline-start: 10px; }
.ds-nav a:hover { color: var(--ink); border-color: var(--line); }
.ds-nav b { font-size: .6875rem; color: var(--ink-3); font-family: var(--mono); letter-spacing: .06em; text-transform: uppercase; margin: 12px 0 4px; }
.ds main > section { padding-block: 40px; border-top: 1.5px solid var(--line); }
.ds main > section:first-child { border-top: 0; padding-top: 0; }
.ds h2 { font-size: var(--fs-3); margin-bottom: 8px; }
.ds h3 { font-size: var(--fs-1); margin: 28px 0 10px; }
.ds p.lead { color: var(--ink-2); max-width: 70ch; margin-bottom: 16px; }
.ds-rules { display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 0; border-top: 1px solid var(--line-3); border-inline-start: 1px solid var(--line-3); }
.ds-rules > div { padding: 16px; border-inline-end: 1px solid var(--line-3); border-bottom: 1px solid var(--line-3); }
.ds-rules b { display: block; margin-bottom: 4px; }
.ds-rules span { color: var(--ink-2); font-size: .9375rem; }
.sw { display: grid; grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); gap: 12px; }
.sw div { border: 1px solid var(--line-3); background: var(--sheet); font-size: .75rem; }
.sw i { display: block; height: 52px; border-bottom: 1px solid var(--line-3); }
.sw span { display: block; padding: 6px 8px; line-height: 1.4; }
.sw code { color: var(--ink-3); }
.tbl-wrap { overflow-x: auto; }
.tbl { width: 100%; font-size: .875rem; border-top: 1.5px solid var(--line); }
.tbl th, .tbl td { text-align: start; padding: 8px 10px 8px 0; border-bottom: 1px solid var(--line-3); vertical-align: top; }
.tbl thead th { font-size: .75rem; color: var(--ink-3); font-weight: 400; }
.tbl td.r { text-align: end; font-family: var(--mono); white-space: nowrap; }
.ok { color: var(--ok); } .warn { color: var(--pending); }
.spec-row { display: grid; grid-template-columns: 140px minmax(0, 1fr); gap: 16px; align-items: baseline; padding: 10px 0; border-bottom: 1px solid var(--line-3); }
.spec-row small { font-family: var(--mono); color: var(--ink-3); font-size: .6875rem; }
.pair { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; }
.pair > * { min-width: 0; }
.pane { border: 1px dashed var(--line-2); padding: 16px; background: var(--paper); }
.pane > small { display: block; font-family: var(--mono); font-size: .6875rem; color: var(--ink-3); margin-bottom: 10px; }
.stack { display: flex; flex-wrap: wrap; gap: 10px; align-items: center; }
.space { display: grid; gap: 6px; }
.space div { display: grid; grid-template-columns: 70px 1fr; align-items: center; gap: 12px; font-family: var(--mono); font-size: .75rem; color: var(--ink-3); }
.space i { display: block; height: 10px; background: var(--tint-2); }
.gridshow { position: relative; height: 120px; display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: var(--col-gap); }
.gridshow i { background: color-mix(in srgb, var(--tint-2) 45%, transparent); border-inline: 1px solid var(--line-2); }
.glyphs { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); border-top: 1px solid var(--line-3); border-inline-start: 1px solid var(--line-3); }
.glyphs div { padding: 14px; border-inline-end: 1px solid var(--line-3); border-bottom: 1px solid var(--line-3); font-size: .75rem; color: var(--ink-2); display: grid; gap: 6px; justify-items: start; }
.glyphs svg { width: 96px; height: 72px; color: var(--line); }
.mini-ws { border: 1.5px solid var(--line); background: var(--sheet); }
.icons { display: flex; flex-wrap: wrap; gap: 16px; }
.icons span { display: grid; justify-items: center; gap: 4px; font-family: var(--mono); font-size: .625rem; color: var(--ink-3); width: 64px; }
.icons svg { width: 24px; height: 24px; color: var(--ink); }
@media (max-width: 899px) { .ds { grid-template-columns: minmax(0, 1fr); } .ds-nav { display: none; } .pair { grid-template-columns: 1fr; } .glyphs { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
</style>
</head>
<body>
{% include "symbols.svg.j2" %}
<aside class="proto" aria-label="Prototype"><div class="wrap"><span>Phase 2 · Design system v0.2 · for Gate 2 review</span><a href="./">Review hub</a></div></aside>
<header class="bar"><div class="wrap bar__in">
  <a class="brand" href="./"><svg aria-hidden="true"><use href="#logo"/></svg><span><b>Nova design system</b><small>Polad Charkhesh · v0.2</small></span></a>
  <nav class="bar__nav" aria-label="Prototypes"><a href="fa.html" lang="fa">نسخه فارسی</a><a href="en.html">English prototype</a></nav>
</div></header>
<div class="wrap ds">
<nav class="ds-nav" aria-label="Design system sections">
  <b>Foundations</b><a href="#principles">Principles</a><a href="#color">Colour and surfaces</a><a href="#type">Typography</a><a href="#space">Spacing and grid</a><a href="#shape">Lines, shape, elevation</a>
  <b>Language</b><a href="#drawing">Technical drawing</a><a href="#bidi">Persian RTL / English LTR</a>
  <b>Components</b><a href="#controls">Controls</a><a href="#data">Data display</a><a href="#explorer">Explorer and workspace</a><a href="#forms">Forms and contact</a>
  <b>Behaviour</b><a href="#motion">Motion and reduced motion</a><a href="#perf">Performance ledger</a>
</nav>
<main>

<section id="principles">
  <h2>Principles</h2>
  <p class="lead">The website is a numbered set of engineering drawings. Every visual rule below exists either because engineers already read it that way, or because it keeps the page fast on a weak connection.</p>
  <div class="ds-rules">
    <div><b>Drawing, not decoration</b><span>Graphics follow drafting conventions (line types, sections, dimensions, balloons) and are generated from product data wherever possible.</span></div>
    <div><b>Two inks on paper</b><span>Navy ink on paper; bright blue only for interaction and focus; amber only for pending data. Colour always means something.</span></div>
    <div><b>Codes are sacred</b><span>Part codes, dimensions and units use Latin digits in monospace, isolated left-to-right, and are never mirrored or translated.</span></div>
    <div><b>Honest data</b><span>Verified and pending are always visible. Pending uses the dashed, hatched "not final" convention, never a hidden footnote.</span></div>
    <div><b>One page, ten sheets</b><span>Sections are numbered sheets. Motion only draws, explodes and reassembles; it never hides content or hijacks scrolling outside one stage.</span></div>
    <div><b>Weight is a design input</b><span>Every decision has a byte and CPU cost, listed in the performance ledger at the end of this page.</span></div>
  </div>
</section>

<section id="color">
  <h2>Colour and surfaces</h2>
  <p class="lead">One token set, three contexts: Whiteprint (default light), Blueprint (dark, follows the device setting) and the Band (the Anatomy section, always blueprint). Values below are read from <code>nova.css</code>, so this page cannot drift from the code.</p>
  {% for name, pal in palettes %}
  <h3>{{ name }}</h3>
  <div class="sw">{% for k, v, role in pal %}<div><i style="background:{{ v }}"></i><span><b>--{{ k }}</b><br><code>{{ v }}</code><br>{{ role }}</span></div>{% endfor %}</div>
  {% endfor %}
  <h3>Contrast, measured (WCAG 2.1)</h3>
  <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Pair</th><th>Use</th><th class="r">Whiteprint</th><th class="r">Blueprint</th><th class="r">Band</th><th>Needs</th></tr></thead><tbody>
  {% for row in contrast %}<tr><td><code>{{ row[0] }}</code></td><td>{{ row[1] }}</td>{% for v in row[2] %}<td class="r {{ 'ok' if v >= row[3] else 'warn' }}">{{ '%.1f'|format(v) }}:1</td>{% endfor %}<td>{{ row[3] }}:1</td></tr>{% endfor %}
  </tbody></table></div>
  <h3>Surface hierarchy</h3>
  <div class="spec-row"><small>--paper</small><span>The page. Sections sit directly on it, separated by rules, not by boxes.</span></div>
  <div class="spec-row"><small>--paper-2</small><span>Recessed: hover rows, the drawing frame inside the band.</span></div>
  <div class="spec-row"><small>--sheet</small><span>Raised: inputs, the product workspace, title blocks, drawing frames. Always with a border; never with a shadow.</span></div>
  <div class="spec-row"><small>.band</small><span>A whole section re-tokened to blueprint. Used once (Anatomy) so it stays an event, not a pattern.</span></div>
</section>

<section id="type">
  <h2>Typography</h2>
  <p class="lead">Two families, two weights each, subset per language and self-hosted. Persian pages load {{ fonts.fa_total }} KB of fonts; English pages {{ fonts.en_total }} KB.</p>
  <div class="tbl-wrap"><table class="tbl"><thead><tr><th>File</th><th>Coverage</th><th>Used on</th><th class="r">Size</th></tr></thead><tbody>
  {% for f in fonts.files %}<tr><td><code>{{ f[0] }}</code></td><td>{{ f[1] }}</td><td>{{ f[2] }}</td><td class="r">{{ f[3] }} KB</td></tr>{% endfor %}
  <tr><td colspan="3" class="muted">For comparison: Vazirmatn full static Regular 50.7 KB; full variable font 111 KB; variable subset 47.7 KB; JetBrains Mono Latin with ligatures 21.2 KB.</td><td></td></tr>
  </tbody></table></div>
  <h3>Scale (ratio ≈ 1.25, display sizes fluid)</h3>
  {% for tok, px, fa_s, en_s, w in scale %}
  <div class="spec-row"><small>--{{ tok }} · {{ px }}</small><div class="pair"><span lang="fa" dir="rtl" style="font-size:var(--{{ tok }});font-weight:{{ w }};line-height:var(--lh-h)">{{ fa_s }}</span><span lang="en" style="font-size:var(--{{ tok }});font-weight:{{ w }};line-height:var(--lh-h)">{{ en_s }}</span></div></div>
  {% endfor %}
  <div class="spec-row"><small>mono · codes</small><div class="pair"><span class="mono" style="font-size:1.875rem;font-weight:600">22220 E</span><span class="mono" style="font-size:1rem">25 × 52 × 15 mm · Ø180 · n lim</span></div></div>
  <h3>Rules</h3>
  <div class="ds-rules">
    <div><b>Line height</b><span>Persian body 1.85, headings 1.45 (tall ascenders and descenders). English body 1.6, headings 1.15.</span></div>
    <div><b>No letter-spacing on Persian</b><span>Tracking breaks cursive joins. Uppercase and tracking are for Latin labels and mono captions only.</span></div>
    <div><b>Digits</b><span>Persian prose, counts, sheet numbers and phone numbers use Persian digits (<span lang="fa">۰۹۱۲ ۷۱۹ ۵۳۱۳</span>); codes, dimensions and units always Latin (<span class="mono">6205-2RS · 25 mm</span>). <code>tel:</code> links always Latin.</span></div>
    <div><b>Dates</b><span>Persian pages show the Solar Hijri calendar (<span lang="fa">۱۲ مهر ۱۴۰۵</span>) via <code>Intl</code> in the browser or PHP <code>intl</code> at publish; English pages show 4 Oct 2026.</span></div>
    <div><b>Fallbacks</b><span>Segoe UI, Tahoma and system fonts behind Vazirmatn; <code>font-display: swap</code> with the Regular weight preloaded. Measured layout shift from the swap: 0.000–0.001.</span></div>
    <div><b>Measure</b><span>Running text stays within 50–70 characters; headings use <code>text-wrap: balance</code>.</span></div>
  </div>
</section>

<section id="space">
  <h2>Spacing and grid</h2>
  <p class="lead">A 4 px base. Layout spacing comes from grid gaps, never from margins on individual blocks.</p>
  <div class="space">{% for k, v in spacing %}<div><span>--{{ k }} {{ v }}</span><i style="width:{{ v }}"></i></div>{% endfor %}</div>
  <h3>Grid</h3>
  <p class="lead">12 columns, max width 1240 px, gutter clamp(16 px, 4vw, 40 px), column gap clamp(16 px, 2.4vw, 32 px). The overlay below is the live grid at this window size.</p>
  <div class="gridshow" aria-hidden="true">{% for i in range(12) %}<i></i>{% endfor %}</div>
  <h3>Breakpoints (where layout actually changes)</h3>
  <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Width</th><th>Change</th></tr></thead><tbody>
    <tr><td class="mono">≥ 1100</td><td>Explorer list + 420 px docked workspace; families in 5 columns.</td></tr>
    <tr><td class="mono">900–1099</td><td>Workspace narrows to 360 px; families in 2 columns.</td></tr>
    <tr><td class="mono">&lt; 900</td><td>Mobile mode: header menu, bottom action dock (Call · WhatsApp · Search), workspace becomes a bottom sheet, Anatomy stacks.</td></tr>
    <tr><td class="mono">&lt; 700</td><td>Result rows stack (code / family / dimensions); facets scroll sideways.</td></tr>
    <tr><td class="mono">&lt; 600</td><td>Sheet heads drop the tick ruler and reference; forms go single-column.</td></tr>
  </tbody></table></div>
</section>

<section id="shape">
  <h2>Lines, shape and elevation</h2>
  <div class="ds-rules">
    <div><b>Radius 2 px</b><span>Drawing sheets have square corners. The only round things are bearings, balloons and status dots.</span></div>
    <div><b>1.5 px structural</b><span>Section rules, sheet heads, inputs, the workspace frame, the action dock.</span></div>
    <div><b>1 px dividers</b><span>Rows, cells, title-block partitions.</span></div>
    <div><b>Dashed means "not final"</b><span>Pending data, empty states, example chips. Never used for decoration.</span></div>
    <div><b>No shadows, blur or gradients</b><span>Elevation comes from surface colour plus a border. This also keeps painting cheap on low-end phones.</span></div>
    <div><b>Focus</b><span>2 px signal-blue outline, 2 px offset, on every interactive element.</span></div>
  </div>
</section>

<section id="drawing">
  <h2>Technical drawing language</h2>
  <p class="lead">Simplified ISO 128-style conventions. Drawings are never mirrored on Persian pages and always read left to right.</p>
  <figure class="dwg" style="margin:0">
    <svg class="dwg-svg draw" viewBox="0 0 760 250" role="img" aria-label="Line conventions">
      <g font-family="JetBrains Mono, monospace" font-size="11" style="fill:var(--ink-3)">
        <text x="20" y="34">OBJECT 1.5</text><path class="ln-obj" data-d pathLength="1" d="M130 30H330"/>
        <text x="20" y="64">THIN 0.9</text><path class="ln-thin" d="M130 60H330"/>
        <text x="20" y="94">HIDDEN</text><path class="ln-hid" d="M130 90H330"/>
        <text x="20" y="124">CENTRE</text><path class="ln-ctr" d="M130 120H330"/>
        <text x="20" y="164">DIMENSION</text><path class="ln-dim" d="M150 140V178M310 140V178"/><path class="ln-dim" d="M150 170H310" marker-start="url(#ar)" marker-end="url(#ar)"/><text class="dim-t" x="230" y="164" text-anchor="middle">Ø52</text>
        <text x="20" y="214">SECTION</text><rect class="fill-sec" x="150" y="196" width="160" height="30"/>
        <text x="400" y="34">LEADER + BALLOON</text>
      </g>
      <g class="balloon"><path class="ln-thin" d="M470 120L520 70"/><circle cx="532" cy="58" r="13"/><text x="532" y="62.5">3</text></g>
      <circle class="fill-paper" cx="470" cy="128" r="14"/>
      <g font-family="JetBrains Mono, monospace" font-size="11" style="fill:var(--ink-3)"><text x="600" y="34">STATUS</text></g>
      <rect x="600" y="50" width="130" height="26" style="fill:var(--ok-bg);stroke:var(--ok)"/><text x="614" y="67" font-size="12" style="fill:var(--ok)">■ Verified</text>
      <rect x="600" y="88" width="130" height="26" style="fill:var(--pending-bg);stroke:var(--pending-line);stroke-dasharray:4 3"/><text x="614" y="105" font-size="12" style="fill:var(--pending)">◌ Pending</text>
    </svg>
    <figcaption><span>LINE TYPES · SECTION HATCH · BALLOONS</span><span>NTS</span></figcaption>
  </figure>
  <h3>Sheet head and title block</h3>
  {{ sheethead(3, 'Product explorer') }}
  <dl class="tblock" style="--cols:4"><div><dt>Company</dt><dd>Polad Charkhesh</dd></div><div><dt>Address</dt><dd>No. 433, Dardasht St, Narmak, Tehran</dd></div><div><dt>Working hours</dt><dd>08:00–16:00</dd></div><div><dt>Landline</dt><dd class="num">+98 21 7720 9117</dd></div></dl>
  <h3>Family glyphs (schematic half-sections, one <code>&lt;symbol&gt;</code> each, reused by <code>&lt;use&gt;</code>)</h3>
  <div class="glyphs">{% for f in families %}<div><svg aria-hidden="true"><use href="#{{ f.glyph }}"/></svg><b>{{ f.en }}</b><span lang="fa">{{ f.fa }}</span></div>{% endfor %}</div>
  <h3>Generated product drawings</h3>
  <p class="lead">Each product's section drawing is built from its boundary dimensions (d, D, B/T/C/H) with the family's template, so a drawing exists even before any photo. Open any product in the prototypes to see one. In production the Publish Engine renders the SVG into the product's HTML.</p>
</section>

<section id="bidi">
  <h2>Persian RTL / English LTR</h2>
  <div class="tbl-wrap"><table class="tbl"><thead><tr><th>Mirror</th><th>Never mirror</th></tr></thead><tbody>
    <tr><td>Page layout, grid order, navigation, the explorer (filters start, workspace end), the Exploded Assembly layout, sticky footers, directional icons (arrows, chevrons, send).</td><td>Technical drawings, dimension text, part codes, numbers inside codes, units, phone numbers (isolated LTR), the logo mark, the decoder breakdown order.</td></tr>
  </tbody></table></div>
  <h3>Mechanics</h3>
  <div class="ds-rules">
    <div><b>Logical properties only</b><span><code>margin-inline</code>, <code>inset-inline-start</code>, <code>border-inline-end</code>, <code>text-align: start</code>; no left/right in the stylesheet except inside drawings.</span></div>
    <div><b>Isolate, don't flip blocks</b><span>Codes sit in <code>&lt;bdi dir="ltr"&gt;</code> inside an RTL block, so they keep their order but align to the start of the Persian line.</span></div>
    <div><b>Inputs</b><span>Search uses <code>dir="auto"</code>: a typed code runs LTR, typed Persian runs RTL; the Persian placeholder is forced RTL and isolates its example code.</span></div>
    <div><b>Search normalisation</b><span>Persian and Arabic digits, Arabic ي/ك, spaces, hyphens, slashes and × are normalised, so typing ۶۲۰۵ (Persian digits) finds 6205.</span></div>
    <div><b>Keyboard</b><span>Arrow keys in the workspace tabs follow reading direction (Left = next in Persian).</span></div>
    <div><b>Second script on each page</b><span>English pages load a Persian-only subset (11.6 KB) so the brand name and family names in Persian shape correctly.</span></div>
  </div>
  <h3>Same component, both directions</h3>
  <div class="pair">
    {% for L in ['fa', 'en'] %}
    <div class="pane" lang="{{ L }}" dir="{{ 'rtl' if L == 'fa' else 'ltr' }}"><small>{{ L|upper }} · {{ 'RTL' if L == 'fa' else 'LTR' }}</small>
      <div class="results" style="border-top-width:1.5px"><ul>
        {% for p in sample_rows %}<li><a class="row" href="{{ L }}.html#p-{{ p.slug }}" style="grid-template-columns:34px minmax(0,1fr) auto;column-gap:12px"><svg class="row__g" style="width:34px" aria-hidden="true"><use href="#{{ fam[p.family].glyph }}"/></svg><span><span class="row__code"><bdi dir="ltr">{{ p.code }}</bdi></span><br><span class="row__fam">{{ fam[p.family][L] }}</span> · <span class="row__dims"><bdi dir="ltr">{{ p.dims_show }}</bdi></span></span><span class="row__st">{% if p.status == 'verified' %}<span class="badge badge--ok" style="background:var(--ok-bg);border-color:currentColor;padding-inline:8px"><span>{{ 'تأییدشده' if L == 'fa' else 'Verified' }}</span></span>{% else %}<span class="badge badge--pending"><span>{{ 'در انتظار تأیید' if L == 'fa' else 'Pending' }}</span></span>{% endif %}</span></a></li>{% endfor %}
      </ul></div>
    </div>
    {% endfor %}
  </div>
</section>

<section id="controls">
  <h2>Controls</h2>
  <h3>Buttons</h3>
  <div class="stack"><a class="btn" href="#controls"><svg class="ico"><use href="#i-chat"/></svg>Check availability on WhatsApp</a><a class="btn btn--line" href="#controls">Inquiry form</a><a class="btn btn--ghost" href="#controls">Ghost</a><a class="btn btn--line btn--icon" href="#controls" aria-label="Call"><svg class="ico"><use href="#i-phone"/></svg></a><a class="btn btn--sm" href="#controls">Small</a><a class="btn btn--lg" href="#controls">Large</a><button class="btn" type="button" disabled>Disabled</button></div>
  <p class="lead" style="margin-top:12px">Primary is navy, never a brand green, even for WhatsApp: one action colour across the site. Minimum target 44 px (36 px for the small size in dense toolbars).</p>
  <h3>Search</h3>
  <div class="pair">
    <form class="search" role="search" aria-label="Persian specimen" lang="fa" dir="rtl" onsubmit="return false"><span class="search__ico"><svg class="ico"><use href="#i-search"/></svg></span><input type="search" dir="auto" aria-label="Persian specimen" placeholder="کد قطعه، مثلاً &#x2066;6205-2RS&#x2069;"><button type="submit">جستجو</button></form>
    <form class="search" role="search" aria-label="English specimen" onsubmit="return false"><span class="search__ico"><svg class="ico"><use href="#i-search"/></svg></span><input type="search" dir="auto" aria-label="English specimen" placeholder="Part code, e.g. 6205-2RS"><button type="submit">Search</button></form>
  </div>
  <h3>Chips, facets, badges, tags</h3>
  <div class="stack"><button class="chip" type="button">6205</button><button class="chip" type="button">22220 E</button>
    <button class="facet" type="button" aria-pressed="true">All</button><button class="facet" type="button" aria-pressed="false">Ball <i>6</i></button><button class="facet" type="button" aria-pressed="false">≤ 20</button>
    <span class="badge badge--ok"><span>Dimensions verified</span></span><span class="badge badge--pending"><span>Technical data pending / Unverified</span></span><a class="tag" href="#controls">Spherical roller bearings</a></div>
  <h3>Icons (1.5 px stroke, 24 grid, one sprite in the page)</h3>
  <div class="icons">{% for i in ['search','close','phone','chat','arrow','chev','copy','link','doc','ext','menu','pin','clock','send'] %}<span><svg aria-hidden="true" class="ico"><use href="#i-{{ i }}"/></svg>{{ i }}</span>{% endfor %}</div>
</section>

<section id="data">
  <h2>Data display</h2>
  <div class="pair">
