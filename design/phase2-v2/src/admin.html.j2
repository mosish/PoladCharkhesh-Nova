          <span style="font-size:13px;color:#aeb8de">تلفن ثابت</span><span class="code" style="color:#fff;font-weight:400">021 7720 9117 · 021 3393 9482</span>
          <span style="font-size:13px;color:#aeb8de">ساعت کاری</span><span>۸:۰۰ تا ۱۶:۰۰</span>
