{#- Admin Control Center wireframes. English presentation chrome; each frame is the Persian RTL admin UI. -#}
{% macro pin(n) %}<i class="pin" aria-label="note {{ n }}">{{ n }}</i>{% endmacro %}
{% macro mark() %}<svg viewBox="0 0 32 32" fill="none" stroke="currentColor" stroke-width="1.6" aria-hidden="true"><circle cx="16" cy="16" r="14"/><circle cx="16" cy="16" r="6"/>{% for a in range(8) %}<circle cx="{{ (16 + 10 * cos(a)) | round(2) }}" cy="{{ (16 + 10 * sin(a)) | round(2) }}" r="2"/>{% endfor %}</svg>{% endmacro %}
{% macro shell(active, unpub=7) %}
<div class="adm" dir="rtl" lang="fa">
  <div class="adm__top">
    <span class="adm__brand">{{ mark() }} پولاد چرخش <small>مرکز کنترل وب‌سایت</small></span>
    <span class="adm__state"><span class="dot"></span> <span><b>{{ fa(unpub) }} تغییر</b> منتشرنشده</span></span>
    <span class="a-btn a-btn--pri">بررسی و انتشار</span>
    <span class="a-btn a-btn--q">مشاهده سایت ↗</span>
    <span class="adm__user"><span class="avatar">م</span> مالک</span>
  </div>
  <div class="adm__body">
    <nav class="adm__nav" aria-label="ناوبری مدیریت">
      {% for grp, items in nav %}
        {% if grp %}<h4>{{ grp }}</h4>{% endif %}
        {% for key, label, n, q in items %}<a {% if key == active %}aria-current="page"{% endif %}><i></i>{{ label }}{% if n %}<span class="n{% if q %} n--q{% endif %}">{{ fa(n) }}</span>{% endif %}</a>{% endfor %}
      {% endfor %}
    </nav>
    <div class="adm__main">{{ caller() }}</div>
  </div>
</div>
{% endmacro %}
{% macro screen(no, id, title, fa_title, purpose) %}
<section class="screen" id="{{ id }}" aria-labelledby="h-{{ id }}">
  <div class="wrap">
    <div class="screen__head"><span class="screen__no">{{ no }}</span><h2 id="h-{{ id }}">{{ title }} <span lang="fa" dir="rtl">{{ fa_title }}</span></h2><p>{{ purpose }}</p></div>
    {{ caller() }}
  </div>
</section>
{% endmacro %}
<!doctype html>
<html lang="en" dir="ltr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="robots" content="noindex, nofollow">
<title>Admin Control Center — wireframes</title>
<style>
@font-face{font-family:"Vazirmatn";src:url(assets/fonts/vazirmatn-Regular-fa.woff2) format("woff2");font-weight:400;font-display:swap}
@font-face{font-family:"Vazirmatn";src:url(assets/fonts/vazirmatn-Bold-fa.woff2) format("woff2");font-weight:700;font-display:swap}
@font-face{font-family:"Vazirmatn";src:url(assets/fonts/vazirmatn-Regular-latin.woff2) format("woff2");font-weight:400;font-display:swap;unicode-range:U+0041-005A,U+0061-007A}
@font-face{font-family:"Vazirmatn";src:url(assets/fonts/vazirmatn-Bold-latin.woff2) format("woff2");font-weight:700;font-display:swap;unicode-range:U+0041-005A,U+0061-007A}
@font-face{font-family:"JetBrains Mono";src:url(assets/fonts/jbmono-400.woff2) format("woff2");font-weight:400;font-display:swap}
@font-face{font-family:"JetBrains Mono";src:url(assets/fonts/jbmono-600.woff2) format("woff2");font-weight:600;font-display:swap}
</style>
<link rel="stylesheet" href="assets/admin-wf.css">
</head>
<body>
<header class="doc-head">
  <div class="wrap">
    <p class="kicker">PC · ADMIN · WIREFRAMES · PHASE 2 V2 · NOT AN IMPLEMENTATION</p>
    <h1>Website Control Center — core screens</h1>
    <p>Low/medium-fidelity UX wireframes for review before Gate 2. The admin is a Persian (RTL) interface at <span class="mono">/admin</span> on the .ir host only (D11). It edits the structured content model in MariaDB; nothing the public sees changes until <b>Publish</b> compiles a new static release. Notes in English map each element to the data model and to rules approved at Gate 1. Nothing here is built yet: no application, schema or Publish Engine exists.</p>
    <ul class="legend">
      <li><i class="pin">1</i> Numbered pins in a frame match the notes under it</li>
      <li><span>Products are the 13 prototype samples (real, sourced dimensions). Inquiries, people, phone numbers in inquiries, counts, times, file names and release IDs are <b>placeholders</b>.</span></li>
      <li>Utilitarian by design: Nova tokens, dense tables, no decorative graphics</li>
    </ul>
    <ul class="toc">
      {% for no, id, t in toc %}<li><a href="#{{ id }}"><b>{{ no }}</b> {{ t }}</a></li>{% endfor %}
    </ul>
  </div>
</header>

<main>
{# ───────────────────────── A1 DASHBOARD ───────────────────────── #}
{% call screen('A1', 'dashboard', 'Dashboard', 'پیشخوان', 'What needs attention now: unpublished changes, new inquiries, demand for codes that are not in the catalogue, data quality, and backup health. No charts or analytics; every number is a link into a filtered list.') %}
<div class="frame-scroll" tabindex="0" role="region" aria-label="A1 Dashboard wireframe">
{% call shell('dash') %}
  <div class="adm__head"><div><p class="crumbs">امروز · ۱۲ مهر ۱۴۰۵</p><h3>پیشخوان</h3></div></div>
  <div class="grid g4" style="margin-bottom:14px">
    <div class="card tile tile--pri"><span class="k">تغییرات منتشرنشده {{ pin(1) }}</span><span class="v">۷</span><span class="s">آخرین انتشار: دیروز ۱۵:۴۲ · نسخه <span class="code">R-0412</span></span><a>بررسی و انتشار ←</a></div>
    <div class="card tile tile--pri"><span class="k">استعلام‌های جدید {{ pin(2) }}</span><span class="v">۳</span><span class="s">قدیمی‌ترین پاسخ‌داده‌نشده: ۲ ساعت پیش</span><a>صندوق استعلام ←</a></div>
    <div class="card tile tile--warn"><span class="k">داده فنی در انتظار تأیید</span><span class="v">۲</span><span class="s">از ۱۳ محصول منتشرشده · noindex تا تأیید</span><a>فهرست محصولات در انتظار ←</a></div>
    <div class="card tile"><span class="k">پشتیبان {{ pin(5) }}</span><span class="v" style="font-size:20px;padding-block:6px">امروز ۰۳:۰۰ <span class="badge b-ok">موفق</span></span><span class="s warn">دانلود هفتگی خارج از سرور: ۸ روز پیش — موعد گذشته</span><a>دانلود پشتیبان کامل ←</a></div>
  </div>
  <div class="grid g-main g-main--wide">
    <div class="grid">
      <div class="card"><h4>استعلام‌های اخیر <span class="actions"><span class="a-btn a-btn--sm">همه</span></span></h4>
        <ul class="list">
          {% for q in inquiries[:4] %}<li>{% if q.new %}<span class="unread" title="خوانده‌نشده"></span>{% endif %}<span class="grow"><b>{{ q.name }}</b> <span class="muted">· {{ q.org }}</span><br>{% for c in q.codes %}<span class="code">{{ c[0] }}</span>{% if not c[1] %} <span class="badge b-pend">در کاتالوگ نیست</span>{% endif %}{% if not loop.last %} · {% endif %}{% endfor %}</span><span class="tag">{{ q.lang|upper }}</span><span class="badge {{ q.st_cls }}">{{ q.st }}</span><span class="tm">{{ q.when }}</span></li>{% endfor %}
        </ul>
      </div>
      <div class="card"><h4>کدهای درخواستی که در کاتالوگ نیستند {{ pin(3) }} <span class="actions muted" style="font-size:12.5px">از متن استعلام‌ها، نه از رفتار بازدیدکنندگان</span></h4>
        <table class="t"><thead><tr><th>کد</th><th>تعداد استعلام</th><th>آخرین درخواست</th><th class="w1"></th></tr></thead><tbody>
          <tr><td><span class="code">6208</span></td><td>۲</td><td>۲ ساعت پیش</td><td class="w1"><span class="a-btn a-btn--sm">ساخت پیش‌نویس محصول</span></td></tr>
          <tr><td><span class="code">NU 2210</span></td><td>۱</td><td>دیروز</td><td class="w1"><a class="a-btn a-btn--link">پیش‌نویس ساخته شد ←</a></td></tr>
          <tr><td><span class="code">UCFL 205</span></td><td>۱</td><td>۳ روز پیش</td><td class="w1"><span class="a-btn a-btn--sm">ساخت پیش‌نویس محصول</span></td></tr>
        </tbody></table>
      </div>
    </div>
    <div class="grid">
      <div class="card"><h4>کیفیت داده {{ pin(4) }}</h4>
        <ul class="list">
          <li><span class="warn-i">!</span><span class="grow">۲ محصول با داده فنی در انتظار تأیید</span><a class="a-btn a-btn--link">رفع</a></li>
          <li><span class="bad-i">!</span><span class="grow">۳ مقدار ابعادی بدون منبع <span class="muted">(<span class="code">TC 25×42×7</span>)</span></span><a class="a-btn a-btn--link">رفع</a></li>
          <li><span class="warn-i">!</span><span class="grow">ترجمه انگلیسی ناقص: ۲ مورد</span><a class="a-btn a-btn--link">رفع</a></li>
          <li><span class="warn-i">!</span><span class="grow">۴ تصویر بدون متن جایگزین</span><a class="a-btn a-btn--link">رفع</a></li>
          <li><span class="ok-i">✓</span><span class="grow muted">عنوان و توضیح سئو: همه در محدوده</span></li>
        </ul>
      </div>
      <div class="card"><h4>فعالیت اخیر {{ pin(6) }}</h4>
        <ul class="list">
          <li><span class="grow">مالک ابعاد <span class="code">30208</span> را ویرایش کرد</span><span class="tm">۱۰:۱۲</span></li>
          <li><span class="grow">ویرایشگر وضعیت استعلام <span class="code">IQ-1024</span> را «در حال پیگیری» کرد</span><span class="tm">۰۹:۴۰</span></li>
          <li><span class="grow">ویرایشگر تصویر جدید بارگذاری کرد</span><span class="tm">۰۹:۱۵</span></li>
          <li><span class="grow">سیستم: پشتیبان روزانه ساخته شد</span><span class="tm">۰۳:۰۰</span></li>
          <li><span class="grow">مالک نسخه <span class="code">R-0412</span> را منتشر کرد</span><span class="tm">دیروز</span></li>
        </ul>
      </div>
    </div>
  </div>
{% endcall %}
</div>
<ol class="notes">
  <li><span><b>Draft → Publish is always visible.</b> The top bar on every screen shows the count of unpublished changes and the Publish entry point; the live site never changes on Save.</span></li>
  <li><span><b>Inquiries first.</b> They are the business outcome of the site, so they lead the dashboard. Each tile is a link into a pre-filtered list; counts are simple queries, with no analytics.</span></li>
  <li><span><b>Demand signal without tracking (C4).</b> Codes named in inquiries that match no designation or alias, after the same normalisation as public search. "Create draft product" pre-fills the designation; the draft stays unpublished until data is entered and sourced.</span></li>
  <li><span><b>Data quality is a to-do list:</b> pending verification, values without a Source, missing fa/en translations, images without alt text, SEO length warnings. Each "Fix" opens the exact field.</span></li>
  <li><span><b>Backup health (D13):</b> last automatic backup and the last weekly off-site download, which turns amber when overdue. Only the Owner can download a full backup.</span></li>
  <li><span><b>Recent activity</b> reads the append-only AuditEvent log (who, what, when).</span></li>
</ol>
{% endcall %}

{# ───────────────────────── A2 PRODUCTS ───────────────────────── #}
{% call screen('A2', 'products', 'Products', 'محصولات', 'Find any product fast, see its data health at a glance, and act on several at once. The list doubles as the verification work queue.') %}
<div class="frame-scroll" tabindex="0" role="region" aria-label="A2 Products wireframe">
{% call shell('products') %}
  <div class="adm__head"><div><p class="crumbs">کاتالوگ</p><h3>محصولات <span class="sub">۱۴ مورد · ۱۳ منتشرشده · ۱ پیش‌نویس</span></h3></div>
    <div class="actions"><span class="a-btn">ورود از فایل CSV {{ pin(8) }}</span><span class="a-btn a-btn--pri">+ محصول جدید</span></div></div>
  <div class="toolbar">
    <span class="a-in a-in--search is-ph">جستجوی کد یا نام مستعار… {{ pin(1) }}</span>
    <span class="a-sel">خانواده: همه</span><span class="a-sel">وضعیت: همه</span><span class="a-sel">داده فنی: همه</span><span class="a-sel">کاوشگر: همه</span>
    <span class="sp"></span><span class="tog">فقط موارد دارای مشکل</span>
  </div>
  <div class="bulk"><span class="chk on"></span><b>۲ مورد انتخاب شد</b><span class="a-btn">انتشار</span><span class="a-btn">بازگشت به پیش‌نویس</span><span class="a-btn">نمایش/پنهان در کاوشگر</span><span class="a-btn">بایگانی…</span> {{ pin(7) }}</div>
  <table class="t">
    <thead><tr><th class="w1"><span class="chk"></span></th><th>کد</th><th>خانواده</th><th>ابعاد اصلی (mm) {{ pin(2) }}</th><th>منبع {{ pin(3) }}</th><th>داده فنی {{ pin(4) }}</th><th>وضعیت</th><th>کاوشگر {{ pin(5) }}</th><th>ترجمه {{ pin(6) }}</th><th>آخرین ویرایش</th><th class="w1"></th></tr></thead>
    <tbody>
    {% for p in products %}
      <tr {% if p.sel %}class="sel"{% endif %}>
        <td class="w1"><span class="chk {% if p.sel %}on{% endif %}"></span></td>
        <td><a class="code">{{ p.code }}</a></td>
        <td class="nw">{{ p.fam_fa }}</td>
        <td class="n">{% if p.dims_cell %}<span class="muted">{{ p.syms }}</span>&nbsp; {{ p.dims_cell }}{% else %}<span class="muted">—</span>{% endif %}</td>
        <td class="n {{ p.src_cls }}">{{ p.src }}</td>
        <td>{% if p.status == 'verified' %}<span class="badge b-ok">تأییدشده</span>{% elif p.draft %}<span class="muted">—</span>{% else %}<span class="badge b-pend">در انتظار</span>{% endif %}</td>
        <td>{% if p.draft %}<span class="badge b-draft">پیش‌نویس</span>{% else %}منتشرشده{% endif %}</td>
        <td>{% if p.draft %}<span class="muted">—</span>{% else %}<span class="good">✓</span>{% endif %}</td>
        <td class="nw"><span class="tag">fa</span> <span class="tag {% if p.en_missing %}bad{% endif %}">en{% if p.en_missing %} ✕{% endif %}</span></td>
        <td class="muted">{{ p.edited }}</td>
        <td class="w1 muted">⋯</td>
      </tr>
    {% endfor %}
    </tbody>
  </table>
  <div class="pager"><span>۱–۱۴ از ۱۴</span><span>۵۰ مورد در هر صفحه</span></div>
{% endcall %}
</div>
<ol class="notes">
  <li><span><b>Search</b> uses the same normaliser as the public explorer and the Publish Engine (Persian/Arabic digits, separators, × and aliases), so <span class="mono">۶۲۰۵ ۲rs</span> finds 6205.</span></li>
  <li><span><b>Dimensions use each family's own symbols</b> (d×D×B, Fw×D×C, d×D×H, d×D×T), read from SpecValue rows and never typed as a string.</span></li>
  <li><span><b>Sources:</b> core values with a cited Source out of core values required. Red means a core value has none. For housings and units, the core list is set in Phase 3 (shown as <span class="mono">?</span>).</span></li>
  <li><span><b>Two independent states.</b> Status (draft / published / archived) and Verification (pending / verified). Together they decide explorer visibility, robots, sitemap and structured data, using the section K table.</span></li>
  <li><span><b>"Show in Product Explorer"</b> is its own flag (D9/C1). Pending products can be discoverable and still be noindex.</span></li>
  <li><span><b>Translation completeness</b> is shown per language. Persian and English are separate fields and are never auto-translated.</span></li>
  <li><span><b>Bulk actions are deliberately few.</b> Archive asks for confirmation and shows the URL consequence (410 or 301, decided in Phase 3). Bulk-verify does not exist: verification is per product, by the Owner.</span></li>
  <li><span><b>CSV import</b> is a migration helper for the existing catalogue (IMPORTANT, not CORE). Imported rows land as drafts with "pending" values until sources are attached.</span></li>
</ol>
{% endcall %}

{# ───────────────────────── A3 PRODUCT EDITOR ───────────────────────── #}
{% call screen('A3', 'editor', 'Product editor', 'ویرایش محصول', 'Tabs mirror the public workspace. The Dimensions & data tab is the heart of the CMS: one row per value, each with its own source, so provenance is per value and not per product.') %}
<div class="frame-scroll" tabindex="0" role="region" aria-label="A3 Product editor wireframe">
{% call shell('products', 8) %}
  <div class="adm__head"><div><p class="crumbs">محصولات / <span class="code">6205</span></p><h3><span class="num">6205</span> <span class="badge b-ok">تأییدشده</span> <span class="badge b-draft">منتشرشده</span></h3></div>
    <div class="actions"><span class="badge b-pend">تغییرات ذخیره‌نشده {{ pin(9) }}</span><span class="a-btn">پیش‌نمایش پیش‌نویس ↗</span><span class="a-btn a-btn--pri">ذخیره</span></div></div>
  <div class="tabs"><span>نمای کلی</span><span class="on">ابعاد و داده‌ها</span><span>رسانه</span><span>مستندات</span><span>سئو</span> {{ pin(1) }}</div>
  <div class="grid g-ed">
    <div class="grid">
      <div class="card">
        <div class="ident">
          <div class="field"><label>کد (Designation)</label><span class="a-in code" dir="ltr">6205</span></div>
          <div class="field"><label>خانواده</label><span class="a-sel">بلبرینگ ساچمه‌ای</span></div>
          <div class="field span2"><label>نام‌های مستعار {{ pin(2) }}</label><div class="chips" dir="ltr"><span class="chip">6205-2RS <span class="x">×</span></span><span class="chip">6205-ZZ <span class="x">×</span></span><span class="chip">6205 2RS <span class="x">×</span></span><span class="muted" style="font-size:12.5px">+ افزودن</span></div></div>
          <div class="field"><label>برند</label><span class="a-sel is-ph muted">— فقط برندهای تأییدشده</span></div>
        </div>
      </div>
      <div class="card"><div class="card__h">ابعاد مرزی (هسته) {{ pin(3) }} <span class="actions muted" style="font-size:12.5px">فهرست کنترل‌شده خانواده «ساچمه‌ای» {{ pin(4) }}</span></div>
        <table class="t spec">
          <thead><tr><th class="w1">نماد</th><th>مقدار</th><th>واحد</th><th>منبع</th><th>تاریخ بررسی</th><th>وضعیت</th></tr></thead>
          <tbody>
            <tr class="core"><td class="sym">d<small>قطر داخلی</small></td><td><span class="a-in val">25</span></td><td class="mono">mm</td><td><span class="a-sel" dir="ltr"><span>123bearing.com — 6205</span></span></td><td>۱۲ مهر ۱۴۰۵</td><td><span class="prov good">● با منبع</span></td></tr>
            <tr class="core"><td class="sym">D<small>قطر خارجی</small></td><td><span class="a-in val">52</span></td><td class="mono">mm</td><td><span class="a-sel" dir="ltr"><span>123bearing.com — 6205</span></span></td><td>۱۲ مهر ۱۴۰۵</td><td><span class="prov good">● با منبع</span></td></tr>
            <tr class="core"><td class="sym">B<small>عرض</small></td><td><span class="a-in val is-focus">15</span></td><td class="mono">mm</td><td><span class="a-sel" dir="ltr"><span>123bearing.com — 6205</span></span></td><td>۱۲ مهر ۱۴۰۵</td><td><span class="prov good">● با منبع</span></td></tr>
          </tbody>
        </table>
      </div>
      <div class="card"><div class="card__h">سایر مشخصات (اختیاری) {{ pin(5) }} <span class="actions"><span class="a-btn a-btn--sm">+ افزودن مشخصه از فهرست</span></span></div>
        <table class="t spec">
          <thead><tr><th class="w1">نماد</th><th>مقدار</th><th>واحد</th><th>منبع</th><th>تاریخ بررسی</th><th>وضعیت</th></tr></thead>
          <tbody>
            <tr><td class="sym">C<sub>r</sub><small>بار دینامیکی پایه</small></td><td><span class="a-in val is-ph"></span></td><td class="mono">kN</td><td><span class="a-sel is-ph muted">انتخاب منبع…</span></td><td class="muted">—</td><td><span class="badge b-pend">در انتظار</span></td></tr>
            <tr><td class="sym">C<sub>0r</sub><small>بار استاتیکی پایه</small></td><td><span class="a-in val is-ph"></span></td><td class="mono">kN</td><td><span class="a-sel is-ph muted">انتخاب منبع…</span></td><td class="muted">—</td><td><span class="badge b-pend">در انتظار</span></td></tr>
            <tr><td class="sym">m<small>جرم</small></td><td class="wrap"><span class="a-in val is-err">x.xx kg</span><span class="err" style="display:block">فقط عدد؛ واحد جداگانه است</span></td><td class="mono">kg</td><td><span class="a-sel is-ph muted">انتخاب منبع…</span></td><td class="muted">—</td><td><span class="badge b-err">نامعتبر</span></td></tr>
          </tbody>
        </table>
      </div>
      <div class="savebar"><span>آخرین ذخیره: ۱۰:۱۲ · مالک</span><span class="sp"></span><span>ذخیره فقط پیش‌نویس را تغییر می‌دهد؛ سایت زنده با «انتشار» به‌روز می‌شود.</span></div>
    </div>
    <div class="grid">
      <div class="card"><div class="card__h">پیش‌نمایش نقشه {{ pin(6) }}</div>
        <div class="card__b" style="padding:10px">
          <div class="dwgp">{{ drawing | safe }}</div>
