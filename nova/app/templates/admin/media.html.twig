{% extends 'shell.html.twig' %}
{% block title %}رسانه{% endblock %}
{% block main %}
<div class="adm__head"><div><p class="crumbs">محتوا</p><h1>رسانه <span class="sub">{{ rows|length|fa }} مورد{% if trash %} در سطل بازیافت{% endif %}</span></h1></div></div>
{% if not trash %}
<section class="card mb" aria-labelledby="h-up"><h2 class="card__h" id="h-up">بارگذاری تصویر</h2>
  <form class="card__b field" method="post" action="/admin/media" enctype="multipart/form-data"><input type="hidden" name="_csrf" value="{{ csrf }}">
    <label for="m-file">فایل تصویر (JPEG، PNG، WebP{% if is_owner %}؛ SVG فقط برای مالک{% endif %})</label>
    <input class="a-in" id="m-file" name="file" type="file" accept="image/jpeg,image/png,image/webp{% if is_owner %},image/svg+xml,.svg{% endif %}" required aria-describedby="m-hint">
    <span class="muted" id="m-hint">محتوای فایل بررسی می‌شود، نه نام آن. فایل دوباره ذخیره می‌شود (فراداده و EXIF حذف و جهت اصلاح می‌شود) و با هش محتوا نام می‌گیرد؛ نسخه‌های WebP واکنش‌گرا ساخته می‌شود.{% if is_owner %} SVG از پالایه امن می‌گذرد و آنچه حذف شد گزارش می‌شود.{% else %} SVG را فقط مالک بارگذاری می‌کند.{% endif %}</span>
    <div><button class="a-btn a-btn--pri" type="submit">بارگذاری</button></div>
  </form>
</section>
{% endif %}
<form class="toolbar" method="get" action="/admin/media" role="search">
  <label class="sr" for="mq">جستجو</label>
  <input class="a-in a-in--search" id="mq" name="q" type="search" value="{{ q }}" placeholder="نام فایل یا متن جایگزین…">
  <label class="sr" for="mk">نوع</label>
  <select class="a-sel" id="mk" name="kind"><option value="">نوع: همه</option><option value="raster"{% if kind == 'raster' %} selected{% endif %}>تصویر</option><option value="svg"{% if kind == 'svg' %} selected{% endif %}>SVG</option></select>
  <label><input type="checkbox" name="trash" value="1"{% if trash %} checked{% endif %}> سطل بازیافت</label>
  <button class="a-btn" type="submit">اعمال</button>
</form>
{% if rows is empty %}
  <div class="card"><p class="empty">{% if trash %}سطل بازیافت خالی است.{% elseif q or kind %}موردی با این جستجو پیدا نشد.{% else %}هنوز تصویری بارگذاری نشده است.{% endif %}</p></div>
{% else %}
<ul class="media-grid">
  {% for m in rows %}
  <li class="card"><a class="media-thumb" href="/admin/media/{{ m.id }}"><img src="{{ m.url }}" alt="" width="{{ m.width }}" height="{{ m.height }}" loading="lazy"><span class="sr">{{ m.original_name }}</span></a>
    <div class="card__b"><b class="mono" dir="ltr">{{ m.original_name }}</b><br><span class="muted"><bdi dir="ltr">{{ m.width }}×{{ m.height }}</bdi> · {{ m.byte_size|size }} · {{ m.kind == 'svg' ? 'SVG' : m.ext|upper }}</span>
      {% if m.role == 'decorative' %}<br><span class="badge b-draft">تزئینی</span>{% elseif m.missing_alt %}<br><span class="badge b-pend">بدون متن جایگزین</span>{% else %}<br><span class="badge b-ok">متن جایگزین کامل</span>{% endif %}</div></li>
  {% endfor %}
</ul>
{% endif %}
{% endblock %}
