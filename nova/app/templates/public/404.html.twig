{% extends 'base.html.twig' %}
{% import 'macros.twig' as m %}
{% block main %}
<main id="main">
<section class="sheet" aria-labelledby="nf-h">
  <div class="wrap">
    {{ m.sheethead(3, t.s3) }}
    <div class="empty pp__none">
      <svg class="ico" aria-hidden="true"><use href="#i-search"/></svg>
      <h1 id="nf-h" class="pp__title">{{ t.nf_h }}</h1>
      <span>{{ t.nf_p }}</span>
      <a class="btn" href="/#explorer">{{ t.nf_home }}</a>
    </div>
  </div>
</section>
</main>
{% endblock %}
