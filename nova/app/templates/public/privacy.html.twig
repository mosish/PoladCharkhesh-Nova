{% extends 'base.html.twig' %}
{% import 'macros.twig' as m %}
{% block sheet_now %}09{% endblock %}
{% block main %}
<main id="main">
<section class="sheet" aria-labelledby="pv-h">
  <div class="wrap">
    {{ m.sheethead(9, t.s9) }}
    <div class="intro"><h1 id="pv-h" class="pp__title">{{ t.pv_h }}</h1></div>
    <div class="rc pp__prose{% if lang == 'en' %} en-prose{% endif %}">
      {% for para in t.pv_paras %}<p>{{ para }}</p>{% endfor %}
    </div>
  </div>
</section>
</main>
{% endblock %}
